public class Main {

    static int fibonacci(int n) {

        // Base case
        if (n <= 1) {
            return n;
        }

        // Recursive calls
        return fibonacci(n - 1) + fibonacci(n - 2);
    }

    public static void main(String[] args) {

        int result = fibonacci(5);

        System.out.println(result);
    }
}
