package org.example;


public class Fibonacci
{
    public static void main(String[] args)
    {

        System.out.println(fibo(6));

    }

    public static int fibo(int n)
    {
        if (n <= 1)
        {
            return n;
        }

        return fibo(n - 1) + fibo(n - 2);
    }

}
