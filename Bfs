import java.util.*;

public class Main {

    static void bfs(int[][] graph, int start) {

        Queue<Integer> q = new LinkedList<>();
        boolean[] visited = new boolean[graph.length];

        q.add(start);
        visited[start] = true;

        while (!q.isEmpty()) {

            int node = q.poll();

            System.out.println(node);

            for (int neighbor : graph[node]) {

                if (!visited[neighbor]) {

                    visited[neighbor] = true;
                    q.add(neighbor);
                }
            }
        }
    }

    public static void main(String[] args) {

        int[][] graph = {
            {1, 2},    // 0
            {0, 3},    // 1
            {0},       // 2
            {1}        // 3
        };

        bfs(graph, 0);
    }
}


BFS repeatedly takes a NODE from the queue, prints/processes it, looks at that node's neighbors in the 2D array,
and puts unvisited neighbors into the queue.
