public class Main {
    public static void main(String[] args) {

        int n = 3;

        int[][] edges = {
            {0, 1},
            {1, 2}
        };

        int[][] graph = new int[n][n];

        for (int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            graph[u][v] = 1;
            graph[v][u] = 1;
        }

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(graph[i][j] + " ");
            }
            System.out.println();
        }
    }
}
