
import java.util.*;

public class Main {

    public static boolean validPath(
            int n, int[][] edges, int source, int destination) {

        // 1. Build adjacency list
        List<List<Integer>> graph = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }

        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];

            graph.get(u).add(v);
            graph.get(v).add(u);
        }

        // 2. Create queue and visited array
        Queue<Integer> q = new LinkedList<>();
        boolean[] visited = new boolean[n];

        // 3. Start BFS
        q.add(source);
        visited[source] = true;

        while (!q.isEmpty()) {




            int node = q.poll();

            if (node == destination) {
                return true;
            }

            for (int neighbor : graph.get(node)) {

                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.add(neighbor);
                }
            }
        }

        return false;
    }

    public static void main(String[] args) {

        int n = 6;

        int[][] edges = {
            {0, 1}, {0, 2},
            {1, 3}, {2, 4},
            {3, 5}, {4, 5}
        };

        System.out.println(validPath(n, edges, 0, 5));
    }
}
